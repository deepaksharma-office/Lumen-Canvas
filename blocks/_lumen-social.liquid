<div class="lumen-header__social" style="--lh-social-gap: {{ block.settings.icon_gap }}px; --lh-icon-size: {{ block.settings.icon_size }}px;" {{ block.shopify_attributes }}>
  {% if block.settings.instagram != blank %}
    <a href="{{ block.settings.instagram }}" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor"/></svg></a>
  {% endif %}
  {% if block.settings.youtube != blank %}
    <a href="{{ block.settings.youtube }}" aria-label="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3z"/></svg></a>
  {% endif %}
  {% if block.settings.linkedin != blank %}
    <a href="{{ block.settings.linkedin }}" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="M7 10v7M7 7v.1M11 17v-7h3v1a3 3 0 0 1 5 2.5V17M14 12v5"/></svg></a>
  {% endif %}
  {% if block.settings.facebook != blank %}
    <a href="{{ block.settings.facebook }}" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 21v-8h3l.5-4H15V7c0-1 .5-1.5 1.6-1.5H19V2.3c-.7-.2-1.7-.3-2.8-.3C13 2 11 4 11 7v2H8v4h3v8z"/></svg></a>
  {% endif %}
</div>
{% schema %}
{
  "name": "Bar social media",
  "settings": [
    { "type": "url", "id": "instagram", "label": "Instagram URL" },
    { "type": "url", "id": "youtube", "label": "YouTube URL" },
    { "type": "url", "id": "linkedin", "label": "LinkedIn URL" },
    { "type": "url", "id": "facebook", "label": "Facebook URL" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 14, "max": 36, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "icon_gap", "label": "Icon gap", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 12 }
  ],
  "presets": [{ "name": "Bar social media" }]
}
{% endschema %}
