{% liquid
  assign placement = block.settings.content_placement
  assign link_url = block.settings.link
  assign card_image = block.settings.image
  assign heading_tag = block.settings.heading_tag
  assign image_alt = card_image.alt | default: block.settings.heading | strip_html
%}

<style>
  #image-content-card-{{ block.id }}.image-content-card {
    --card-text-color: {{ block.settings.text_color }};
    --card-image-radius: {{ block.settings.image_radius }}px;
    --card-content-padding: {{ block.settings.content_padding }}px;
    display: block;
    position: relative;
    width: 100%;
    color: var(--card-text-color);
  }

  #image-content-card-{{ block.id }} .image-content-card__link,
  #image-content-card-{{ block.id }} .image-content-card__static {
    display: block;
    position: relative;
    color: inherit;
    text-decoration: none;
  }

  #image-content-card-{{ block.id }} .image-content-card__link:visited,
  #image-content-card-{{ block.id }} .image-content-card__link:hover,
  #image-content-card-{{ block.id }} .image-content-card__link:focus-visible {
    color: inherit;
    text-decoration: none;
  }

  #image-content-card-{{ block.id }} .image-content-card__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  /* Image wrapper + aspect ratio */
  #image-content-card-{{ block.id }} .image-content-card__media {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: var(--card-image-radius);
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
  }

  #image-content-card-{{ block.id }} .image-content-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #image-content-card-{{ block.id }} .image-content-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: #eee;
  }

  #image-content-card-{{ block.id }} .image-content-card__placeholder svg {
    width: 100%;
    height: 100%;
  }

  #image-content-card-{{ block.id }} .image-content-card__content {
    padding: var(--card-content-padding);
    text-align: var(--card-text-align);
  }

  #image-content-card-{{ block.id }} .image-content-card__heading {
    margin: 0;
    color: inherit;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  #image-content-card-{{ block.id }} .image-content-card__description {
    margin: 8px 0 0;
    color: inherit;
  }

  #image-content-card-{{ block.id }} .image-content-card__description p {
    margin: 0;
  }

  #image-content-card-{{ block.id }} .image-content-card__description p + p {
    margin-top: 8px;
  }

  #image-content-card-{{ block.id }}.image-content-card--over .image-content-card__content {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: var(--card-v-align);
    align-items: var(--card-h-align);
    pointer-events: none;
  }

  #image-content-card-{{ block.id }}.image-content-card--top_center .image-content-card__content,
  #image-content-card-{{ block.id }}.image-content-card--middle_center .image-content-card__content,
  #image-content-card-{{ block.id }}.image-content-card--bottom_center .image-content-card__content {
    text-align: center;
  }

  #image-content-card-{{ block.id }}.image-content-card--top_right .image-content-card__content,
  #image-content-card-{{ block.id }}.image-content-card--middle_right .image-content-card__content,
  #image-content-card-{{ block.id }}.image-content-card--bottom_right .image-content-card__content {
    text-align: right;
  }

  #image-content-card-{{ block.id }}.image-content-card--over .image-content-card__heading,
  #image-content-card-{{ block.id }}.image-content-card--over .image-content-card__description {
    max-width: 100%;
  }
</style>

{% capture card_body %}
  <div class="image-content-card__media">
    {% if card_image != blank %}
      {{ card_image | image_url: width: 2000 | image_tag:
        class: 'image-content-card__image',
        loading: 'lazy',
        widths: '320, 480, 640, 750, 990, 1200, 1500, 2000',
        sizes: '(min-width: 750px) 50vw, 100vw',
        alt: image_alt
      }}
    {% else %}
      <div class="image-content-card__placeholder">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  {% if block.settings.heading != blank or block.settings.description != blank %}
    <div class="image-content-card__content">
      {% if block.settings.heading != blank %}
        <{{ heading_tag }} class="image-content-card__heading">
          {{ block.settings.heading | escape }}
        </{{ heading_tag }}>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="image-content-card__description">
          {{ block.settings.description | strip_html | escape | newline_to_br }}
        </div>
      {% endif %}
    </div>
  {% endif %}
{% endcapture %}

<div
  id="image-content-card-{{ block.id }}"
  class="image-content-card image-content-card--{{ placement }} image-content-card--{{ block.settings.over_position }}"
  style="
    --card-text-align: {{ block.settings.below_alignment }};

    {% case block.settings.over_position %}
      {% when 'top_left' %}
        --card-v-align: flex-start;
        --card-h-align: flex-start;
      {% when 'top_center' %}
        --card-v-align: flex-start;
        --card-h-align: center;
      {% when 'top_right' %}
        --card-v-align: flex-start;
        --card-h-align: flex-end;
      {% when 'middle_left' %}
        --card-v-align: center;
        --card-h-align: flex-start;
      {% when 'middle_center' %}
        --card-v-align: center;
        --card-h-align: center;
      {% when 'middle_right' %}
        --card-v-align: center;
        --card-h-align: flex-end;
      {% when 'bottom_left' %}
        --card-v-align: flex-end;
        --card-h-align: flex-start;
      {% when 'bottom_center' %}
        --card-v-align: flex-end;
        --card-h-align: center;
      {% when 'bottom_right' %}
        --card-v-align: flex-end;
        --card-h-align: flex-end;
    {% endcase %}
  "
  {{ block.shopify_attributes }}
>
  {% if link_url != blank %}
    <a
      class="image-content-card__link"
      href="{{ link_url }}"
      aria-label="{{ block.settings.heading | default: image_alt | default: 'View image' | escape }}"
    >
      {{ card_body }}
    </a>
  {% else %}
    <div class="image-content-card__static">
      {{ card_body }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Image content card",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Card link"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "3 / 2",
          "label": "Landscape (3:2)"
        },
        {
          "value": "16 / 9",
          "label": "Wide (16:9)"
        },
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "2 / 3",
          "label": "Portrait (2:3)"
        },
        {
          "value": "9 / 16",
          "label": "Tall (9:16)"
        }
      ],
      "default": "4 / 3"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "content_placement",
      "label": "Content placement",
      "options": [
        {
          "value": "over",
          "label": "Over image"
        },
        {
          "value": "below",
          "label": "Below image"
        }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "over_position",
      "label": "Position over image",
      "visible_if": "{{ block.settings.content_placement == 'over' }}",
      "options": [
        {
          "value": "top_left",
          "label": "Top left"
        },
        {
          "value": "top_center",
          "label": "Top center"
        },
        {
          "value": "top_right",
          "label": "Top right"
        },
        {
          "value": "middle_left",
          "label": "Middle left"
        },
        {
          "value": "middle_center",
          "label": "Middle center"
        },
        {
          "value": "middle_right",
          "label": "Middle right"
        },
        {
          "value": "bottom_left",
          "label": "Bottom left"
        },
        {
          "value": "bottom_center",
          "label": "Bottom center"
        },
        {
          "value": "bottom_right",
          "label": "Bottom right"
        }
      ],
      "default": "bottom_left"
    },
    {
      "type": "select",
      "id": "below_alignment",
      "label": "Text alignment below image",
      "visible_if": "{{ block.settings.content_placement == 'below' }}",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1A1A1A"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content spacing",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Image content card"
    }
  ]
}
{% endschema %}
