{% liquid
  assign logo_alt = block.settings.image.alt | default: shop.name
  assign logo_link = block.settings.link | default: routes.root_url
%}
<div class="lumen-header__logo" style="--lh-logo-width: {{ block.settings.width }}px;" {{ block.shopify_attributes }}>
  <a class="lumen-header__logo-link" href="{{ logo_link }}" aria-label="{{ logo_alt | escape }}">
    {% if block.settings.image != blank %}
      {{ block.settings.image | image_url: width: 800 | image_tag: class: 'lumen-header__logo-image', loading: 'lazy', widths: '120, 180, 240, 360, 480, 800', sizes: '240px', alt: logo_alt }}
    {% else %}
      <span class="lumen-header__logo-text">{{ shop.name | escape }}</span>
    {% endif %}
  </a>
</div>
{% schema %}
{
  "name": "Bar image or logo",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "url", "id": "link", "label": "Image link" },
    { "type": "range", "id": "width", "label": "Image width", "min": 80, "max": 400, "step": 10, "unit": "px", "default": 200 }
  ],
  "presets": [{ "name": "Bar image or logo" }]
}
{% endschema %}
